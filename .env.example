# Civic Commons Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# =============================================================================
# DATABASE (Required)
# =============================================================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=civic_commons
POSTGRES_USER=commons
POSTGRES_PASSWORD=CHANGE_ME_secure_password_here

# Connection string (auto-generated from above in docker-compose)
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# MCP SERVER (Required)
# =============================================================================
# API key for authenticating MCP requests
MCP_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
MCP_PORT=8080
MCP_HOST=0.0.0.0

# =============================================================================
# WEB APPS - NextAuth (Required)
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3002

# Admin app URL (if different)
ADMIN_URL=http://localhost:3003

# =============================================================================
# PORT CONFIGURATION
# =============================================================================
# Change these if defaults conflict with other services
WEB_PORT=3002
ADMIN_PORT=3003
DB_PORT=5432

# =============================================================================
# ADMIN CREDENTIALS - Development Only
# =============================================================================
# For local development only. Use OAuth in production.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=CHANGE_ME_secure_password

# =============================================================================
# CITY CONFIGURATION
# =============================================================================
# Default config file to load
DEFAULT_CONFIG=twinsburg.yaml

# Timezone for scheduling
TZ=America/New_York

# =============================================================================
# OPTIONAL: OAuth Providers (Production)
# =============================================================================
# Uncomment and configure for production authentication

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth (useful for admin access)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# =============================================================================
# OPTIONAL: Email / Newsletters
# =============================================================================
# Required for newsletter and alert features

# SMTP Configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=true

# Sender address
# EMAIL_FROM=noreply@civiccommons.local
# EMAIL_REPLY_TO=support@civiccommons.local

# =============================================================================
# OPTIONAL: Monitoring & Logging
# =============================================================================
# Error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Log aggregation
# LOGFLARE_API_KEY=
# LOGFLARE_SOURCE_ID=

# Log level: debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# OPTIONAL: External Services
# =============================================================================
# If using external PDF processing
# PDF_SERVICE_URL=

# If using external search (future)
# MEILISEARCH_URL=
# MEILISEARCH_API_KEY=

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================
# Set to 'development' or 'production'
NODE_ENV=development

# Enable debug logging for specific components
# DEBUG=civic:*

# Skip certain scrapers during development
# SKIP_SCRAPERS=facebook_events,metroparks

# Dry run mode - don't write to database
# DRY_RUN=true
